{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "autoupdate": "notify",
  "formatter": true,
  "default_agent": "architect",
  "subagent_depth": 1,
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "whoami": "allow",
      "echo *": "allow",
      "which *": "allow",
      "where *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git stat": "allow",
      "git stat *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "git remote": "allow",
      "git remote *": "allow",
      "gh pr view *": "allow",
      "gh pr list *": "allow",
      "gh pr diff *": "allow",
      "gh pr view": "allow",
      "gh pr list": "allow",
      "gh issue view *": "allow",
      "gh issue list *": "allow",
      "gh repo view *": "allow",
      "gh run view *": "allow",
      "gh run list *": "allow",
      "gh release list *": "allow",
      "gh release view *": "allow"
    },
    "edit": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc": "deny",
      "**/.pypirc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc": "deny",
      "**/.pypirc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "glob": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc": "deny",
      "**/.pypirc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "grep": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials/**": "deny",
      "**/id_rsa": "deny",
      "**/id_dsa": "deny",
      "**/id_ecdsa": "deny",
      "**/id_ed25519": "deny",
      "**/.npmrc": "deny",
      "**/.yarnrc": "deny",
      "**/.pypirc": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.p12": "deny",
      "**/*.pfx": "deny"
    },
    "question": "allow",
    "webfetch": "ask",
    "websearch": "allow"
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "pnpm",
        "dlx",
        "@playwright/mcp"
      ],
      "enabled": false
    },
    "caveman": {
      "type": "local",
      "command": [
        "C:\\Users\\santi\\.caveman\\bin\\caveman-mcp.exe"
      ],
      "enabled": false
    }
  },
  "provider": {
    "openai": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/openai/v1"
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:8787/w/opencode/anthropic/v1"
      }
    }
  }
}
